# AegisHarness Platform: synthetic configuration template only.
# The service reads process environment variables; it does not auto-load this file.
# Set credentials through your process environment or secret manager.

# Observability: comma-separated application repositories, or demo.
AEGISHARNESS_PLATFORM_USAGE_DATA_SOURCE=demo
AEGISHARNESS_PLATFORM_AEGISHARNESS_ROOTS=
AEGISHARNESS_PLATFORM_USAGE_SYNC_CONFIG=
AEGISHARNESS_PLATFORM_USAGE_SYNC_CACHE=
AEGISHARNESS_PLATFORM_USAGE_AI_ENABLED=false
AEGISHARNESS_PLATFORM_USAGE_AI_BASE_URL=
AEGISHARNESS_PLATFORM_USAGE_AI_API_KEY=
AEGISHARNESS_PLATFORM_USAGE_AI_MODEL=

# Framework evaluation: source checkout, Git ref and business repository mappings.
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_AEGISHARNESS_REPOSITORY=
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_REFERENCE_REF=
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_REPOSITORIES=
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_CONFIG_PATH=
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_CASE_SOURCE_ROOT=
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_WORK_ROOT=
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_MAX_CONCURRENCY=2
AEGISHARNESS_PLATFORM_EVALUATION_CODEX_BASE_URL=
AEGISHARNESS_PLATFORM_EVALUATION_CODEX_API_KEY=
AEGISHARNESS_PLATFORM_EVALUATION_CODEX_MODEL=
AEGISHARNESS_PLATFORM_EVALUATION_CLAUDE_BASE_URL=
AEGISHARNESS_PLATFORM_EVALUATION_CLAUDE_API_KEY=
AEGISHARNESS_PLATFORM_EVALUATION_CLAUDE_MODEL=
AEGISHARNESS_PLATFORM_EVALUATION_SUBAGENT_REVIEWER_API_KEY=
AEGISHARNESS_PLATFORM_EVALUATION_TUTORIAL_VIDEO_PATH=

# Optional independent runtime storage paths; use absolute paths.
AEGISHARNESS_PLATFORM_FRAMEWORK_EVAL_DB_PATH=
AEGISHARNESS_PLATFORM_TELEMETRY_DB_PATH=
AEGISHARNESS_PLATFORM_STAGE_SUPPLEMENT_DB_PATH=
AEGISHARNESS_PLATFORM_FEEDBACK_DB_PATH=
AEGISHARNESS_PLATFORM_USAGE_FIRST_SEEN_DB_PATH=
AEGISHARNESS_PLATFORM_FEATURE_EXCLUSION_DB_PATH=
AEGISHARNESS_PLATFORM_EVOLUTION_DB_PATH=
AEGISHARNESS_PLATFORM_WORKER_PROCESS_REGISTRY=

# Evolution is disabled until the operator configures evidence and capabilities.
AEGISHARNESS_PLATFORM_EVOLUTION_SCHEDULER_ENABLED=false
AEGISHARNESS_PLATFORM_EVOLUTION_SEMANTIC_ANALYZER_ENABLED=false
AEGISHARNESS_PLATFORM_EVOLUTION_CATALOG_PATH=
AEGISHARNESS_PLATFORM_EVOLUTION_RUNTIME_CONFIG_PATH=
AEGISHARNESS_PLATFORM_EVOLUTION_WORKTREE_ROOT=
AEGISHARNESS_PLATFORM_EVOLUTION_EXECUTION_USER=

# Optional public case-creator distribution configuration.
AEGISHARNESS_PLATFORM_CASE_CREATOR_GIT_URL=
AEGISHARNESS_PLATFORM_CASE_CREATOR_GIT_REF=
AEGISHARNESS_PLATFORM_CASE_CREATOR_CODEX_INSTALL_URL=
AEGISHARNESS_PLATFORM_CASE_CREATOR_PLUGIN_ROOT=
